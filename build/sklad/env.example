# Переименуйте в .env (в папке приложения на хостинге) и заполните.
# Переменные, заданные в cPanel «Setup Node.js App → Environment variables», имеют приоритет над этим файлом.

# PostgreSQL из cPanel (раздел «PostgreSQL Databases»): postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:5432/БАЗА
# Пусто — встроенная PGlite в ./.data/pglite (только при одном процессе приложения!)
DATABASE_URL=
DB_POOL=5

# Публичный адрес с https://
APP_URL=https://crm.example.kz
# Длинная случайная строка (не меняйте после запуска — сломаются выданные ссылки)
APP_SECRET=

# При старте применить миграции и создать сотрудников, если база пустая (пароли → .data/initial-passwords.txt)
DB_AUTO_SETUP=1

# Встроенный планировщик выключен: Passenger усыпляет процессы. Проверки дёргает cron из cPanel (см. ИНСТРУКЦИЯ).
DISABLE_SCHEDULER=1
CRON_SECRET=

# Web Push (npm run vapid локально)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.kz

STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=  (по умолчанию ./uploads)

ANTHROPIC_API_KEY=
WHATSAPP_PROVIDER=
ASSISTANT_PROVIDER=
