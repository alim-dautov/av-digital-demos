# Подключение к PostgreSQL. Если не задано — используется встроенная PGlite (./.data/pglite) для локальной разработки.
DATABASE_URL=postgres://demo:demo@localhost:5432/demo
# Публичный адрес приложения (для ссылок на акты/КП и push)
APP_URL=http://localhost:3000
# Секрет для подписи публичных ссылок (любой длинный случайный текст)
APP_SECRET=change-me-to-long-random-string
# Web Push (npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Хранилище файлов: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# LLM для распознавания накладных (опционально)
ANTHROPIC_API_KEY=
# WhatsApp: пусто — заглушка (wa.me); реализуйте провайдера в src/modules/whatsapp/provider.ts
WHATSAPP_PROVIDER=
# ИИ-ассистент: пусто — локальная заглушка; реализуйте AssistantProvider в src/modules/assistant/provider.ts
ASSISTANT_PROVIDER=
# Внешний cron: POST /api/cron с заголовком x-cron-secret
CRON_SECRET=
# 1 — отключить встроенный планировщик (если несколько инстансов)
DISABLE_SCHEDULER=

# --- Демо-режим ---
# 1 — выдуманные данные, вход одной кнопкой, плашка «Это демо», без загрузок и вебхуков.
DEMO_MODE=
# Ссылка кнопки «Хотите такую же систему?»
DEMO_CONTACT_URL=
