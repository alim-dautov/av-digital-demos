Options -Indexes

<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Shell, worker, and manifest must revalidate so a deploy is not stuck in cache.
  <FilesMatch "^(index\.html|offline\.html|sw\.js|push-sw\.js|registerSW\.js|manifest\.webmanifest|workbox-.+\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Hashed Vite assets: name-HASH.ext under /assets/
  RewriteRule ^assets/.+-[A-Za-z0-9]{8,}\.(js|css|woff2|woff|png|jpe?g|webp|svg|gif)$ - [E=DEMO_IMMUTABLE:1]

  # API. Shared hosting often drops Authorization on the rewrite to index.php.
  RewriteCond %{REQUEST_URI} ^/api
  RewriteRule ^api/(.*)$ index.php [QSA,L,E=HTTP_AUTHORIZATION:%{HTTP:Authorization},E=DEMO_NOSTORE:1]

  # Existing files
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA shell is not cached; the service worker still precaches hashed assets.
  RewriteRule ^ index.html [L,E=DEMO_HTML:1]
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=DEMO_IMMUTABLE
  Header set Cache-Control "no-store" env=DEMO_NOSTORE
  Header set Cache-Control "no-cache, no-store, must-revalidate" env=DEMO_HTML
</IfModule>
