{
  "name": "demo/crm",
  "description": "Demo CRM — sales, tasks, control, 1C exchange",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "minishlink/web-push": "^9.0",
    "dompdf/dompdf": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Trx\\": "api/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Trx\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php scripts/migrate.php",
    "seed": "php scripts/seed.php"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  }
}
