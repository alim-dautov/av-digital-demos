# Секрет подписи сессий. В production обязателен, минимум 32 символа:
#   openssl rand -base64 48
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Первый владелец, создаётся в production при пустой базе (пароль от 12 символов)
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_NAME=

# Web Push (VAPID): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.kz

# Коннектор Grok Bot: токен для заголовка Authorization: Bearer (от 32 символов).
# Пусто — интеграция не подключена. Хранить только на сервере:
#   openssl rand -base64 48
GROK_CONNECTOR_TOKEN=

# --- Демо-режим ---
DEMO_MODE=1
ALLOW_DEMO_ACCOUNTS=true
DEMO_CONTACT_URL=https://av-digital.kz/#contact
CRON_SECRET=
